    <Profile name="globalMarketRowCellLeft" extends="baseReference" with="anchorStretchingYLeft">
        <size value="155px 32px"/>
        <textBold value="false"/>
        <textSize value="15px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="globalMarketRowCellLeftBright" extends="globalMarketRowCellLeft">
        <textBold value="true"/>
    </Profile>

    <Profile name="globalMarketRowCellRight" extends="globalMarketRowCellLeft">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="globalMarketRowCellArrow" extends="baseReference" with="anchorMiddleLeft">
        <size value="18px 18px"/>
        <imageSliceId value="gui.priceTrend"/>
        <imageColor value="$preset_colorTransparent"/>
    </Profile>

    <Profile name="globalMarketRowCellArrowClimbing" extends="globalMarketRowCellArrow">
        <imageColor value="$preset_colorGreen"/>
        <imageRotation value="0"/>
    </Profile>

    <Profile name="globalMarketRowCellArrowFalling" extends="globalMarketRowCellArrow">
        <imageColor value="$preset_colorRed"/>
        <imageRotation value="180"/>
    </Profile>

