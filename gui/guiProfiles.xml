    <Profile name="selectLevelHeaderCellR" extends="selectLevelHeaderCell" textColor="$preset_colorRed"/>
    <Profile name="selectLevelHeaderCell2" extends="selectLevelHeaderCell" textAlignment="center"/>

    <Profile name="selectLevelTextInput" extends="textInput" with="anchorMiddleLeft" handleFocus="true" position="20px 0" size="350px 48px" margin="30px 28px 49px 16px" maxInputTextWidth="290px" textSize="18px" textBold="false" textAlignment="center" textVerticalAlignment="middle" enterWhenClickOutside="true"/>

    <Profile name="ingameMenuGlobalMarketSelectListLeft" extends="emptyPanel" with="anchorTopLeft" size="350px 350px" position="20px -140.77px"/>
    <Profile name="ingameMenuGlobalMarketSelectListLeftItem" extends="baseReference" with="anchorTopLeft" size="350px 40.77px"/>

    <Profile name="ingameMenuGlobalMarketSelectLoadingAnimation" extends="baseReference" with="anchorTopCenter" size="127px 127px" pivot="0.5 0.5" position="0px -100px" imageUVs="293px 495px 127px 127px" imageColor="$preset_colorMainUI" animationMode="rotate" animationSpeed="1000">
        <Variant name="mobile" size="60px 60px"/>
    </Profile>

    <!-- FS25 - Global Market Custom Slider Profiles -->
    <!-- Custom slider inheriting from FS25 vanilla, colored in green -->
    <Profile name="globalMarketListSlider" extends="fs25_listSlider">
        <sliderImageColor value="$preset_fs25_colorMainHighlight"/>
        <startImageColor value="$preset_fs25_colorMainHighlight"/>
        <endImageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <!-- Section Header Profiles for Categorized SmoothLists (#19) -->
    <Profile name="globalMarketSectionHeader" extends="baseReference" with="anchorTopStretchingX">
        <height value="28px"/>
        <imageColor value="0.06 0.07 0.08 0.92"/>
        <allowSelected value="false"/>
    </Profile>

    <Profile name="globalMarketSectionHeaderTitle" extends="baseReference" with="anchorStretchingYLeft">
        <position value="12px 0px"/>
        <size value="680px 28px"/>
        <textSize value="14px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <!-- Search Input & Category Mode Toolbar Profiles (#12 & #19) -->
    <Profile name="globalMarketSearchInputBg" extends="baseReference" with="anchorStretchingYStretchingX">
        <size value="100% 100%"/>
        <imageSliceId value="gui.3dShop_button_middle"/>
        <imageColor value="$preset_fs25_colorTextInput"/>
        <startImageSize value="6px 0px"/>
        <startImageSliceId value="gui.3dShop_button_left"/>
        <startImageColor value="$preset_fs25_colorTextInput"/>
        <endImageSize value="6px 0px"/>
        <endImageSliceId value="gui.3dShop_button_right"/>
        <endImageColor value="$preset_fs25_colorTextInput"/>
