    <Profile name="globalMarketHeaderRight" extends="globalMarketHeader">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="globalMarketHeaderBright" extends="globalMarketHeader">
        <textColor value="$preset_colorWhite"/>
    </Profile>

    <Profile name="globalMarketHeaderRightBright" extends="globalMarketHeaderRight">
        <textColor value="$preset_colorWhite"/>
    </Profile>

    <Profile name="globalMarketHeaderBox" extends="emptyPanel" with="anchorTopLeft">
        <imageColor value="$preset_colorListHeaderBackground"/>
        <hasFrame value="false"/>
    </Profile>

    <Profile name="globalMarketList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
        <position value="0px -40px"/>
        <absoluteSizeOffset value="0px 80px"/>
    </Profile>

    <Profile name="globalMarketListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="32px"/>
        <imageColor value="$preset_fs25_colorGrey"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <Profile name="globalMarketRowCellImage" extends="baseReference" with="anchorMiddleLeft">
        <size value="24px 24px"/>
        <position value="8px 0"/>
        <imageSliceId value="noSlice"/>
