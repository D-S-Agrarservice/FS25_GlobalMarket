<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- ========================================================================================= -->
<!-- FS25_GlobalMarket - guiProfiles.xml                                                       -->
<!-- Custom GUI presets and element profiles for Global Market menus, lists, and toolbars.     -->
<!-- Author: D-S-Agrarservice                                                                  -->
<!-- ========================================================================================= -->
<GUIProfiles>
    <Presets>
        <Preset name="colorWhite" value="1 1 1 1"/>
        <Preset name="colorRed" value="1 0 0 1"/>
    </Presets>

    <Profile name="globalMarketMenuHeaderIcon" with="anchorMiddleCenter">
        <size value="50px 50px"/>
        <imageUVs value="0 0 1 1"/>
        <imageColor value="0 0 0 1"/>
        <imageSliceId value="noSlice"/>
        <imageFilename value="$moddir$FS25_GlobalMarket/images/storageList.dds"/>
    </Profile>

    <Profile name="globalMarketHeader" extends="baseReference">
        <size value="155px 32px"/>
        <imageColor value="0 0 0 0"/>
        <textFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="left"/>
    </Profile>

    <Profile name="globalMarketHeaderRight" extends="globalMarketHeader">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="globalMarketHeaderBright" extends="globalMarketHeader">
        <textColor value="$preset_colorWhite"/>
    </Profile>

    <Profile name="globalMarketHeaderRightBright" extends="globalMarketHeaderRight">
        <textColor value="$preset_colorWhite"/>
    </Profile>

    <Profile name="globalMarketListItem" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="32px"/>
        <imageColor value="$preset_fs25_colorGrey"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <Profile name="globalMarketRowCellImage" extends="baseReference" with="anchorMiddleLeft">
        <size value="24px 24px"/>
        <position value="8px 0"/>
        <imageSliceId value="noSlice"/>
    </Profile>

    <Profile name="globalMarketRowCellLeft" extends="baseReference" with="anchorStretchingYLeft">
        <size value="155px 32px"/>
        <textBold value="false"/>
        <textSize value="15px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="globalMarketRowCellLeftBright" extends="globalMarketRowCellLeft">
        <textBold value="true"/>
    </Profile>

    <Profile name="globalMarketRowCellRight" extends="globalMarketRowCellLeft">
        <textAlignment value="right"/>
    </Profile>

    <Profile name="globalMarketRowCellArrow" extends="baseReference" with="anchorMiddleLeft">
        <size value="18px 18px"/>
        <imageSliceId value="gui.priceTrend"/>
        <imageColor value="$preset_colorTransparent"/>
    </Profile>

    <Profile name="globalMarketRowCellArrowClimbing" extends="globalMarketRowCellArrow">
        <imageColor value="$preset_colorGreen"/>
        <imageRotation value="0"/>
    </Profile>

    <Profile name="globalMarketRowCellArrowFalling" extends="globalMarketRowCellArrow">
        <imageColor value="$preset_colorRed"/>
        <imageRotation value="180"/>
    </Profile>

    <Profile name="globalMarketRowCellArrowGreatDemand" extends="globalMarketRowCellArrow">
        <imageColor value="0.05 0.65 1.00 1"/>
        <imageSelectedColor value="0.02 0.35 0.85 1"/>
        <imageHighlightedColor value="0.05 0.65 1.00 1"/>
        <imageFocusedColor value="0.05 0.65 1.00 1"/>
        <imageRotation value="0"/>
        <animationMode value="blink"/>
    </Profile>

    <Profile name="globalMarketFooterBox1" extends="baseReference" with="anchorBottomStretchingX">
        <size value="100% 50px"/>
    </Profile>

    <!-- FS25 - Global Market Custom Slider Profiles -->
    <!-- Custom slider inheriting from FS25 vanilla, colored in green -->
    <Profile name="globalMarketListSlider" extends="fs25_listSlider">
        <sliderImageColor value="$preset_fs25_colorMainHighlight"/>
        <startImageColor value="$preset_fs25_colorMainHighlight"/>
        <endImageColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>
    <!-- Section Header Profiles for Categorized SmoothLists -->
    <Profile name="globalMarketSectionHeader" extends="baseReference" with="anchorTopStretchingX">
        <height value="28px"/>
        <imageColor value="0.06 0.07 0.08 0.92"/>
        <allowSelected value="false"/>
    </Profile>

    <Profile name="globalMarketSectionHeaderTitle" extends="baseReference" with="anchorStretchingYLeft">
        <position value="12px 0px"/>
        <size value="680px 28px"/>
        <textSize value="14px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="left"/>
        <textVerticalAlignment value="middle"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <!-- Search Input & Category Mode Toolbar Profiles -->
    <Profile name="globalMarketSearchInputBg" extends="baseReference" with="anchorStretchingYStretchingX">
        <size value="100% 100%"/>
        <imageSliceId value="gui.3dShop_button_middle"/>
        <imageColor value="$preset_fs25_colorTextInput"/>
        <startImageSize value="6px 0px"/>
        <startImageSliceId value="gui.3dShop_button_left"/>
        <startImageColor value="$preset_fs25_colorTextInput"/>
        <endImageSize value="6px 0px"/>
        <endImageSliceId value="gui.3dShop_button_right"/>
        <endImageColor value="$preset_fs25_colorTextInput"/>
    </Profile>

    <Profile name="globalMarketSearchInput" extends="fs25_textInput" with="anchorMiddleCenter">
        <size value="330px 32px"/>
        <maxInputTextWidth value="300px"/>
        <textSize value="16px"/>
        <textAlignment value="center"/>
    </Profile>

    <Profile name="globalMarketToolbarBtnBg" extends="globalMarketSearchInputBg">
        <imageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <imageFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <Profile name="globalMarketToolbarBtnSmall" extends="emptyPanel" with="anchorMiddleLeft">
        <size value="34px 32px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textPadding value="0px 0px"/>
        <textAlignment value="center"/>
        <textColor value="$preset_colorWhite"/>
        <textHighlightedColor value="$preset_fs25_colorMainDark"/>
        <textFocusedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="globalMarketToolbarBtnMode" extends="globalMarketToolbarBtnSmall">
        <size value="260px 32px"/>
        <textSize value="15px"/>
    </Profile>

    <Profile name="globalMarketToolbarBtnAction" extends="globalMarketToolbarBtnSmall">
        <size value="214px 32px"/>
        <textSize value="15px"/>
        <textLayoutMode value="resize"/>
    </Profile>

    <Profile name="globalMarketSubTabBtn" extends="emptyPanel" with="anchorMiddleLeft">
        <size value="210px 34px"/>
        <textSize value="15px"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textPadding value="4px 0px"/>
        <textAlignment value="center"/>
        <textLayoutMode value="resize"/>
        <textColor value="$preset_colorWhite"/>
        <textHighlightedColor value="$preset_fs25_colorMainDark"/>
        <textFocusedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <Profile name="globalMarketSubTabBgActive" extends="globalMarketSearchInputBg">
        <imageColor value="$preset_fs25_colorMainHighlight"/>
        <startImageColor value="$preset_fs25_colorMainHighlight"/>
        <endImageColor value="$preset_fs25_colorMainHighlight"/>
        <imageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <imageFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <startImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        <endImageFocusedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <Profile name="globalMarketCustomLogo" extends="baseReference" with="anchorBottomLeft">
        <size value="240px 120px"/>
        <imageUVs value="0 0 1 1"/>
        <imageColor value="1 1 1 1"/>
        <imageSliceId value="noSlice"/>
    </Profile>
</GUIProfiles>