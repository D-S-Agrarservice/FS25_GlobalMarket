<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="GlobalMarketDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="globalMarketDialogBg" id="dialogElement">

        <ThreePartBitmap profile="fs25_dialogBgMiddle" with="anchorStretch" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer" size="100% 100%">
            <Text profile="fs25_siloDialogTitle" id="dialogTitleElement" />
            <Text profile="fs25_siloDialogText" id="dialogInfoTextElement" />

            <MultiTextOption profile="globalMarketStorageDropdown" id="storageSelectionElement" onClick="onClickStorage">
                <Text profile="fs25_multiTextOptionText" name="text" absoluteSizeOffset="90px 0px" position="15px 0px" />
            </MultiTextOption>

            <MultiTextOption profile="globalMarketFormatDropdown" id="formatSelectionElement" onClick="onClickFormat" isVisible="false">
                <Text profile="fs25_multiTextOptionText" name="text" absoluteSizeOffset="90px 0px" position="15px 0px" />
            </MultiTextOption>

            <GuiElement profile="globalMarketInputGroup" with="anchorTopCenter">
                <GuiElement profile="emptyPanel" position="0px 0px" size="200px 40px" with="anchorMiddleLeft">
                    <Bitmap profile="fs25_textInputBg" size="100% 100%" />
                    <TextInput profile="globalMarketAmountInput" id="amountInput" onTextChanged="onAmountChanged" text="0" maxCharacters="10" />
                </GuiElement>

                <Button profile="globalMarketMaxButton" text="MAX" onClick="onClickMaxAmount" />

                <Text profile="globalMarketInputUnitText" id="inputUnitText" text="$l10n_ui_gm_unit_liter" />
            </GuiElement>

            <Text profile="globalMarketTotalText" id="totalValueText" text="Total: 0" />
            <!-- NEW: Delivery cost UI element, hidden by default -->
            <Text profile="globalMarketDeliveryText" id="deliveryCostText" text="Delivery: 0" isVisible="false" />
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK" text="$l10n_button_start" onClick="onClickOk" id="yesButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton" />
        </BoxLayout>
    </GuiElement>

    <GUIProfiles>
        <Profile name="globalMarketDialogBg" extends="fs25_dialogBg" with="anchorMiddleCenter">
            <size value="620px 470px" />
        </Profile>

        <Profile name="fs25_siloDialogTitle" extends="fs25_dialogTitle">
            <width value="580px" />
            <position value="0px -30px" />
        </Profile>

        <Profile name="fs25_siloDialogText" extends="fs25_dialogText">
            <width value="580px" />
            <position value="0px -80px" />
            <textAutoWidth value="true" />
        </Profile>

        <Profile name="globalMarketStorageDropdown" extends="fs25_multiTextOption" with="anchorTopCenter">
            <width value="400px" />
            <position value="0px -140px" />
        </Profile>

        <Profile name="globalMarketFormatDropdown" extends="fs25_multiTextOption" with="anchorTopCenter">
            <width value="400px" />
            <position value="0px -190px" />
        </Profile>

        <Profile name="globalMarketInputGroup" extends="emptyPanel" with="anchorTopCenter">
            <size value="400px 40px" />
            <position value="0px -260px" />
        </Profile>

        <Profile name="globalMarketAmountInput" extends="fs25_textInput" with="anchorMiddleCenter">
            <size value="200px 40px" />
            <textSize value="22px" />
            <textAlignment value="center" />
        </Profile>

        <Profile name="globalMarketMaxButton" extends="buttonBase" with="anchorMiddleLeft">
            <size value="80px 40px" />
            <position value="210px 0px" />
            <textSize value="20px" />
            <textBold value="true" />
            <textPadding value="10px 0px" />
            <textAlignment value="center" />
            <textColor value="$preset_colorWhite" />
            <textHighlightedColor value="$preset_fs25_colorMainDark" />
            <textFocusedColor value="$preset_fs25_colorMainDark" />
            <imageColor value="0 0 0 0.4" />
            <imageHighlightedColor value="$preset_fs25_colorMainHighlight" />
            <imageFocusedColor value="$preset_fs25_colorMainHighlight" />
        </Profile>

        <Profile name="globalMarketInputUnitText" extends="fs25_textDefault" with="anchorMiddleLeft">
            <width value="90px" />
            <position value="300px 0px" />
            <textSize value="18px" />
            <textAlignment value="left" />
            <textColor value="$preset_colorWhite" />
        </Profile>

        <Profile name="globalMarketTotalText" extends="fs25_dialogText" with="anchorTopCenter">
            <width value="580px" />
            <position value="0px -330px" />
            <textAlignment value="center" />
            <textWrap value="true" />
        </Profile>

        <!-- NEW: Profile for the delivery cost text, positioned slightly below the total text -->
        <Profile name="globalMarketDeliveryText" extends="fs25_dialogText" with="anchorTopCenter">
            <width value="580px" />
            <position value="0px -360px" />
            <textAlignment value="center" />
            <textWrap value="true" />
            <textColor value="0.9 0.6 0.1 1" /> <!-- Soft orange to distinguish from total price -->
        </Profile>
    </GUIProfiles>
</GUI>