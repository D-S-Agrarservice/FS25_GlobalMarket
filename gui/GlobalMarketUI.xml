<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="GlobalMarketUI">
    <GuiElement profile="fs25_menuContainer" id="mainContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="globalMarketMenuHeaderIcon" id="gmMenuHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="$l10n_ui_ingameMenuGlobalMarketHeaderMarket" />
            <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg" />
            <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
                <Text profile="fs25_shopBalance" text="$l10n_ui_gm_balance" />
                <Text profile="fs25_shopMoney" id="currentBalanceText" />
            </BoxLayout>
        </GuiElement>

        <GuiElement profile="emptyPanel" with="anchorBottomLeft" size="700px 750px" position="20px 40px">
            <Text profile="globalMarketHeaderBright" text="$l10n_ui_ingameMenuGlobalMarketHeaderStorage" position="10px 715px" size="680px 30px" textSize="22px" />

            <!-- Shared Search Toolbar (#12) -->
            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 652px" size="700px 34px">
                <Text profile="globalMarketHeader" position="10px 5px" size="90px 24px" text="$l10n_ui_gm_search_label" />
                <GuiElement profile="emptyPanel" position="105px 0px" size="330px 32px" with="anchorMiddleLeft">
                    <ThreePartBitmap profile="globalMarketSearchInputBg" />
                    <TextInput profile="globalMarketSearchInput" id="searchTextInput" onTextChanged="onSearchTextChanged" onEnterPressed="onSearchEnterPressed" enterWhenClickOutside="true" maxCharacters="30" />
                </GuiElement>
                <Button profile="globalMarketToolbarBtnSmall" id="btnClearSearch" position="442px 0px" text="X" onClick="onClickClearSearch">
                    <ThreePartBitmap profile="globalMarketToolbarBtnBg" />
                </Button>
            </GuiElement>

            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 608px" size="700px 38px">
                <Text profile="globalMarketHeader" position="40px 8px" size="310px 24px" text="$l10n_ui_ingameMenuGlobalMarketFruit" />
                <Text profile="globalMarketHeaderRight" position="360px 8px" size="320px 24px" text="$l10n_ui_ingameMenuGlobalMarketAvailable" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 0px" size="700px 2px" />
            </GuiElement>

            <!-- Wrapper container to constrain the list and provide an anchor point for the slider -->
            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 10px" size="700px 592px">
                <!-- List takes full size of the wrapper (700px width) -->
                <SmoothList profile="emptyPanel" id="gmTableStorage" size="100% 100%" listSectionHeader="section" handleFocus="true" selectedWithoutFocus="false" showHighlights="true" onDoubleClick="onButtonAction">
                    <ListItem profile="globalMarketListItem" name="gmTableStorageRowTemplate">
                        <Bitmap name="alternating" size="100% 100%" imageColor="1 1 1 0.05" />
                        <Bitmap profile="globalMarketRowCellImage" name="icon" position="8px 0px" />
                        <Text profile="globalMarketRowCellLeftBright" position="40px 0px" size="310px 32px" name="name" />
                        <Text profile="globalMarketRowCellRight" position="360px 0px" size="320px 32px" name="amount" />
                    </ListItem>
                    <ListItem profile="globalMarketSectionHeader" name="section">
                        <Text profile="globalMarketSectionHeaderTitle" name="title" />
                    </ListItem>
                </SmoothList>

                <!-- FS25 native slider track. Automatically anchors to the right edge and offsets by 21px -->
                <ThreePartBitmap profile="fs25_listSliderBox">
                    <Slider profile="globalMarketListSlider" dataElementId="gmTableStorage" id="gmTableStorageSlider" />
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <GuiElement profile="emptyPanel" with="anchorBottomLeft" size="710px 750px" position="790px 40px">
            <Text profile="globalMarketHeaderBright" id="marketStatusTitle" text="$l10n_ui_ingameMenuGlobalMarketOffline" position="10px 715px" size="690px 30px" textSize="22px" />
            <Text profile="fs25_textDefault" id="marketStatusDesc" text="$l10n_ui_ingameMenuGlobalMarketOfflineDesc" position="10px 695px" size="690px 24px" textSize="16px" textColor="0.7 0.7 0.7 1" />

            <!-- Category View Mode Switcher Toolbar (#19) -->
            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 652px" size="710px 34px">
                <Button profile="globalMarketToolbarBtnMode" id="btnCategoryMode" position="450px 0px" text="$l10n_ui_gm_cat_mode_detailed" onClick="onClickToggleCategoryMode">
                    <ThreePartBitmap profile="globalMarketToolbarBtnBg" />
                </Button>
            </GuiElement>

            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 608px" size="710px 38px">
                <Text profile="globalMarketHeader" position="10px 8px" size="240px 24px" text="$l10n_ui_ingameMenuGlobalMarketFruit" />
                <Text profile="globalMarketHeaderRight" position="260px 8px" size="150px 24px" text="$l10n_ui_ingameMenuGlobalMarketPrice" />
                <Text profile="globalMarketHeader" position="440px 8px" size="100px 24px" text="$l10n_ui_gm_trend" />
                <Text profile="globalMarketHeaderRight" position="510px 8px" size="180px 24px" text="$l10n_ui_ingameMenuGlobalMarketCount" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 0px" size="710px 2px" />
            </GuiElement>

            <!-- Wrapper container to constrain the list and provide an anchor point for the slider -->
            <GuiElement profile="emptyPanel" with="anchorBottomLeft" position="0px 10px" size="710px 592px">
                <!-- List takes full size of the wrapper (710px width) -->
                <SmoothList profile="emptyPanel" id="gmTableMarket" size="100% 100%" listSectionHeader="section" handleFocus="true" selectedWithoutFocus="false" showHighlights="true" onDoubleClick="onButtonAction">
                    <ListItem profile="globalMarketListItem" name="gmTableMarketRowTemplate">
                        <Bitmap name="alternating" size="100% 100%" imageColor="1 1 1 0.05" />
                        <Bitmap profile="globalMarketRowCellImage" name="icon" position="8px 0px" />
                        <Text profile="globalMarketRowCellLeftBright" position="40px 0px" size="235px 32px" textLayoutMode="resize" name="name" />
                        <Text profile="globalMarketRowCellRight" position="260px 0px" size="150px 32px" name="price" />
                        <Bitmap profile="globalMarketRowCellArrow" position="452px 2px" name="trend" />
                        <Text profile="globalMarketRowCellRight" position="510px 0px" size="180px 32px" name="amount" />
                    </ListItem>
                    <ListItem profile="globalMarketSectionHeader" name="section">
                        <Text profile="globalMarketSectionHeaderTitle" name="title" />
                    </ListItem>
                </SmoothList>

                <!-- FS25 native slider track. Automatically anchors to the right edge and offsets by 21px -->
                <ThreePartBitmap profile="fs25_listSliderBox">
                    <Slider profile="globalMarketListSlider" dataElementId="gmTableMarket" id="gmTableMarketSlider" />
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>

        <GuiElement profile="globalMarketFooterBox1">
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="0px -15dp" />
            <Text profile="globalMarketHeaderBright" position="40px 0px" text="$l10n_ui_gm_total_storage"/>
            <Text profile="globalMarketHeaderRightBright" position="380px 0px" size="320px 32px" id="totalStorageDisplay" text="0 L"/>
        </GuiElement>

    </GuiElement>
</GUI>
