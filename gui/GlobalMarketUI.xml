<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="GlobalMarketUI">
    <GuiElement profile="fs25_menuContainer" id="mainContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="globalMarketMenuHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="$l10n_ui_ingameMenuGlobalMarketHeaderMarket" />

            <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg" />
            <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
                <Text profile="fs25_shopBalance" text="KONTOSTAND:" />
                <Text profile="fs25_shopMoney" id="currentBalanceText" />
            </BoxLayout>
        </GuiElement>

        <GuiElement size="650px 750px" position="20px 40px">
            <Text profile="fs25_statisticsHeaderText" text="$l10n_ui_ingameMenuGlobalMarketHeaderStorage" position="10px 710px" />

            <GuiElement position="0px 660px" size="650px 40px">
                <Text profile="globalMarketHeader" position="40px 10px" size="250px 24px" text="$l10n_ui_ingameMenuGlobalMarketFruit" />
                <Text profile="globalMarketHeaderRight" position="300px 10px" size="300px 24px" text="$l10n_ui_ingameMenuGlobalMarketAvailable" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 0px" size="650px 2px" />
            </GuiElement>

            <SmoothList profile="emptyPanel" id="gmTableStorage" position="0px 10px" size="650px 640px" handleFocus="true" selectedWithoutFocus="false" showHighlights="true">
                <ListItem profile="globalMarketListItem" name="gmTableStorageRowTemplate">
                    <Bitmap name="alternating" size="100% 100%" imageColor="1 1 1 0.05" />
                    <Bitmap profile="globalMarketRowCellImage" name="icon" position="8px 4px" />
                    <Text profile="globalMarketRowCellLeftBright" position="40px 0px" size="250px 32px" name="name" />
                    <Text profile="globalMarketRowCellRight" position="300px 0px" size="300px 32px" name="amount" />
                </ListItem>
            </SmoothList>
        </GuiElement>

        <GuiElement size="650px 750px" position="700px 40px">
            <Text profile="fs25_statisticsHeaderText" text="$l10n_ui_ingameMenuGlobalMarketOffline" position="10px 710px" />

            <GuiElement position="0px 660px" size="650px 40px">
                <Text profile="globalMarketHeader" position="10px 10px" size="200px 24px" text="$l10n_ui_ingameMenuGlobalMarketFruit" />
                <Text profile="globalMarketHeaderRight" position="220px 10px" size="150px 24px" text="$l10n_ui_ingameMenuGlobalMarketPrice" />
                <Text profile="globalMarketHeader" position="390px 10px" size="40px 24px" text="TR." />
                <Text profile="globalMarketHeaderRight" position="440px 10px" size="180px 24px" text="$l10n_ui_ingameMenuGlobalMarketCount" />
                <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 0px" size="650px 2px" />
            </GuiElement>

            <SmoothList profile="emptyPanel" id="gmTableMarket" position="0px 10px" size="650px 640px" handleFocus="true" selectedWithoutFocus="false" showHighlights="true">
                <ListItem profile="globalMarketListItem" name="gmTableMarketRowTemplate">
                    <Bitmap name="alternating" size="100% 100%" imageColor="1 1 1 0.05" />
                    <Bitmap profile="globalMarketRowCellImage" name="icon" position="8px 4px" />
                    <Text profile="globalMarketRowCellLeftBright" position="40px 0px" size="200px 32px" name="name" />
                    <Text profile="globalMarketRowCellRight" position="220px 0px" size="150px 32px" name="price" />
                    <Bitmap profile="globalMarketRowCellArrow" position="400px 7px" name="trend" />
                    <Text profile="globalMarketRowCellRight" position="440px 0px" size="180px 32px" name="amount" />
                </ListItem>
            </SmoothList>
        </GuiElement>

        <GuiElement profile="globalMarketFooterBox1">
            <ThreePartBitmap profile="fs25_lineSeparatorTop" position="0px -15dp" />
            <Text profile="globalMarketHeaderBright" position="40px 0px" text="GESAMT BESTAND:"/>
            <Text profile="globalMarketHeaderRightBright" position="400px 0px" size="310px 32px" id="totalStorageDisplay" text="0 L"/>
        </GuiElement>

    </GuiElement>
</GUI>